/results/
/data/generated/

# Qdrant defaults when a local backend is started from the repository root.
/storage/
/snapshots/
/qdrant*.zip

# Local projection exports; authored configurations and test fixtures stay tracked.
/projections.json
/projections-*.json

# Go binaries, test executables, coverage and profiling output.
/semcache
/bin/
/dist/
*.exe
*.test
*.out
*.coverprofile
*.prof
*.pprof
*.trace
/coverage
/coverage.*

